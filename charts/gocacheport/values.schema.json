{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["replicaCount", "cache", "image", "persistence"],
  "properties": {
    "replicaCount": {"const": 1},
    "image": {
      "type": "object",
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "cache": {
      "type": "object",
      "properties": {
        "diskBytes": {"type": "integer", "minimum": 57},
        "maxEntries": {"type": "integer", "minimum": 1},
        "maxObjectBytes": {"type": "integer", "minimum": 1},
        "memoryBytes": {"type": "integer", "minimum": 0},
        "memoryObjectBytes": {"type": "integer", "minimum": 0},
        "maxConcurrent": {"type": "integer", "minimum": 1},
        "ttl": {"type": "string"},
        "requestTimeout": {"type": "string", "minLength": 1},
        "shutdownTimeout": {"type": "string", "minLength": 1}
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "existingClaim": {"type": "string"},
        "size": {"type": "string", "minLength": 1},
        "storageClass": {"type": "string"},
        "retain": {"type": "boolean"}
      }
    },
    "tracing": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "endpoint": {"type": "string", "pattern": "^https?://"},
        "sampleRatio": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "logLevel": {"enum": ["debug", "info", "warn", "error"]},
    "terminationGracePeriodSeconds": {"type": "integer", "minimum": 1},
    "startupProbe": {
      "type": "object",
      "required": ["periodSeconds", "failureThreshold"],
      "properties": {
        "periodSeconds": {"type": "integer", "minimum": 1},
        "failureThreshold": {"type": "integer", "minimum": 1}
      }
    },
    "extraEnv": {"type": "array"},
    "imagePullSecrets": {"type": "array"},
    "networkPolicy": {
      "type": "object",
      "properties": {
        "clientsFrom": {"type": "array", "minItems": 1},
        "monitoringFrom": {"type": "array", "minItems": 1}
      }
    }
  }
}
